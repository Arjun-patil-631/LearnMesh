# ==============================================================================
# LearnMesh Enterprise Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["*"]

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./learnmesh.db
# Production: PostgreSQL
# DATABASE_URL=postgresql://learnmesh:securepass@localhost:5432/learnmesh

# Hindsight Long-Term Memory Service
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=learnmesh-org-fleet
HINDSIGHT_TIMEOUT_SECONDS=10.0

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15.0

# Feature Flags
FEATURE_CIRCUIT_BREAKER=true
FEATURE_BACKGROUND_QUEUE=true
FEATURE_IDEMPOTENCY=true
FEATURE_PROMETHEUS_METRICS=true
FEATURE_DEGRADED_LOCAL_CACHE=true

# Resilience & Circuit Breaker
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT_SECONDS=30.0
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=0.5
