# LearnMesh Environment Configuration

# Hindsight Long-Term Memory Configuration
# When using local self-hosted or embedded Hindsight:
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=learnmesh-org-fleet

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Application & Database Configuration
DATABASE_URL=sqlite:///./learnmesh.db
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
FRONTEND_PORT=3000
